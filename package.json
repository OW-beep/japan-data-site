{
  "name": "japan-data-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",

    "update:data": "tsx scripts/buildCities.ts",

    "find:finance": "tsx scripts/findFinanceMeta.ts",
    "find:table": "tsx scripts/findFinanceTable.ts",
    "find:birth": "tsx scripts/findBirthMeta.ts",

    "merge:finance": "tsx scripts/mergeSocialStat.ts",

    "merge:ssdse": "tsx scripts/fetchSSDSE.ts",

    "estat:search": "tsx scripts/estatSearchTables.ts",
    "estat:meta": "tsx scripts/estatMetaInfo.ts",
    "merge:vacant-house": "tsx scripts/fetchVacantHouseRate.ts",
    "merge:daytime-population": "tsx scripts/fetchDaytimePopulation.ts",
    "merge:elderly-facilities": "tsx scripts/fetchElderlyFacilities.ts",
    "merge:young-adult-migration": "tsx scripts/fetchYoungAdultMigration.ts",
    "merge:recycling-rate": "tsx scripts/fetchRecyclingRate.ts",
    "merge:community-centers": "tsx scripts/fetchCommunityCenters.ts",

    "convert:area": "tsx scripts/convertAreaCsv.ts",

    "merge": "tsx scripts/mergeData.ts",

    "refresh:data": "npm run update:data && npm run merge:finance && npm run merge:ssdse && npm run merge",

    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "dotenv": "^17.2.0",
    "iconv-lite": "^0.6.3",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}